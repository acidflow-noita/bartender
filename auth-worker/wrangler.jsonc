{
  "name": "bartender-auth",
  "compatibility_date": "2025-07-22",
  "main": "src/index.js",

  // Production environment (default)
  "vars": {
    "MAIN_SITE_URL": "https://bartender.runfast.stream",
    "WORKER_URL": "https://bartender-auth.wuote.workers.dev"
  },

  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "bartender-auth",
      "database_id": "23102bd2-260f-443e-a32d-a8976c283937"
    }
  ],

  // Environment configurations
  "env": {
    "test": {
      "name": "bartender-auth-test",
      "vars": {
        "MAIN_SITE_URL": "https://auth-test-bartender.wuote.workers.dev",
        "WORKER_URL": "https://bartender-auth-test.wuote.workers.dev"
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "bartender-auth-test",
          "database_id": "c27f6d8e-f541-4af2-8ed7-d25cf8f66f5d"
        }
      ]
    }
  }
}
